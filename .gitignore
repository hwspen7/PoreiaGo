
# Aligo Travel Assistant - repository ignore rules

# Local environment and private credentials
.env
.env.*
!.env.example
!.env.sample
!env.example
*.pem
*.p12
*.pfx
*.key
credentials.json
secrets.json

# Python bytecode, packaging, and test caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.egg-info/
.eggs/
build/
.venv/
venv/
ENV/
.conda/

# React, TypeScript, Vite, and Node
node_modules/
web/dist/
.vite/
*.tsbuildinfo
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# SQLite databases, journals, and server locks
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.sqlite3.*.lock
data/*.lock
data/*.pid

# Downloaded models and local data caches
.cache/
.huggingface/
data/cache/
data/models/
*.gguf
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx

# Generated evaluation reports and runtime outputs
/reports/
/logs/
/output/
/outputs/
/tmp/
/temp/
/playwright-report/
/test-results/
*.log
*.pid

# Local IDE and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
