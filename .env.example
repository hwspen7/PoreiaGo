# Start with the backend on localhost. Enable online providers only when you accept their terms.
POREIAGO_ALLOW_ONLINE=false
POREIAGO_DATABASE_PATH=data/poreiago.sqlite3
POREIAGO_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
POREIAGO_MEMORY_WINDOW=40
POREIAGO_MAX_SKILL_CALLS=8
POREIAGO_REQUEST_TIMEOUT=12
POREIAGO_RETRIEVAL_MODE=lexical
POREIAGO_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
POREIAGO_RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v2
# Set POREIAGO_ACCESS_TOKEN for remote hosting. The default is localhost-only development.
POREIAGO_ACCESS_TOKEN=
POREIAGO_REASONING_API_KEY=
POREIAGO_ROUTER_API_KEY=
POREIAGO_SYNTHESIS_API_KEY=
POREIAGO_OPENAI_API_KEY=
ORS_API_KEY=
DUFFEL_ACCESS_TOKEN=
DUFFEL_MODE=test

# V3.1 generalized runtime limits
POREIAGO_MAX_PARALLEL_SKILLS=4
POREIAGO_INTENT_TIMEOUT=25
POREIAGO_EXECUTION_TIMEOUT=90
POREIAGO_SYNTHESIS_TIMEOUT=15

# V3.3: model-assisted intent fallback and bounded alternative Skills
POREIAGO_INTENT_MODEL_ROLES=router,reasoning
POREIAGO_MAX_RECOVERY_STEPS=2

# Optional Places API: use a dedicated POI service when public Overpass is unavailable.
# When configured, Geoapify is preferred, and Overpass remains a fallback.
GEOAPIFY_API_KEY=

# Additional optional provider credentials: leave empty to keep capabilities explicitly unavailable.
TICKETMASTER_API_KEY=
BOOKING_API_TOKEN=
BOOKING_AFFILIATE_ID=
BOOKING_MODE=sandbox
# GTFS/rail, official visa rules and restaurant booking require partner-specific adapters.

# REST Countries v5 is optional and requires a key; without it PoreiaGo uses limited World Bank country reference data.
RESTCOUNTRIES_API_KEY=

# Local Ollama (optional): uncomment both lines when running a downloaded local model.
# These values activate local inference; leave commented for cloud-only inference.
# POREIAGO_LOCAL_MODEL=qwen3.5:9b
# POREIAGO_OLLAMA_API_KEY=ollama

# Model-first multilingual travel planning. Keep the key server-side only.
POREIAGO_AGENT_MODE=model-first
GROQ_API_KEY=
POREIAGO_GROQ_MODEL=qwen/qwen3.8-27b

# Content quality checks are read-only and included in the API response.
# Optional: enable one bounded quality refinement if a new trip is weak.
# May increase latency by an additional local model generation.
POREIAGO_CONTENT_REVIEW_MODE=adaptive

# Candidate and professional Skill budgets (bounded; defaults favor small local models).
POREIAGO_MAX_DISCOVERY_CITIES=4
POREIAGO_CITY_CANDIDATE_LIMIT=12
POREIAGO_DAY_CANDIDATE_LIMIT=7
POREIAGO_PROFESSIONAL_SKILL_BUDGET=5
POREIAGO_PROFESSIONAL_RESULTS_PER_SKILL=4
# Cache only stable geocoding and mapped candidate lookups. No weather/booking caching.
POREIAGO_GEOCODE_CACHE_TTL=900
POREIAGO_PLACES_CACHE_TTL=300
# SSE keepalives and bounded pending messages.
POREIAGO_SSE_HEARTBEAT_SECONDS=15
POREIAGO_SSE_QUEUE_SIZE=64
# A bearer token alone does not establish a user identity or support multitenancy.
# For intentionally shared single-user remote access only, explicitly enable:
POREIAGO_ALLOW_SHARED_REMOTE=false

# Diagnostic benchmark ablation: none, nine, eighteen (default).
POREIAGO_ITINERARY_SKILL_MODE=eighteen
