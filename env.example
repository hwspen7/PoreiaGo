# Start with the backend on localhost. Enable online providers only when you accept their terms.
ALIGO_ALLOW_ONLINE=false
ALIGO_DATABASE_PATH=data/aligo_v3.sqlite3
ALIGO_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALIGO_MEMORY_WINDOW=40
ALIGO_MAX_SKILL_CALLS=8
ALIGO_REQUEST_TIMEOUT=12
ALIGO_RETRIEVAL_MODE=lexical
ALIGO_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
ALIGO_RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v2
# Set ALIGO_ACCESS_TOKEN for remote hosting. The default is localhost-only development.
ALIGO_ACCESS_TOKEN=
ALIGO_REASONING_API_KEY=
ALIGO_ROUTER_API_KEY=
ALIGO_SYNTHESIS_API_KEY=
ALIGO_OPENAI_API_KEY=
ORS_API_KEY=
DUFFEL_ACCESS_TOKEN=
DUFFEL_MODE=test

# V3.1 generalized runtime limits
ALIGO_MAX_PARALLEL_SKILLS=4
ALIGO_INTENT_TIMEOUT=25
ALIGO_EXECUTION_TIMEOUT=90
ALIGO_SYNTHESIS_TIMEOUT=15

# V3.3: model-assisted intent fallback and bounded alternative Skills
ALIGO_INTENT_MODEL_ROLES=router,reasoning
ALIGO_MAX_RECOVERY_STEPS=2

# Optional Places API: use a dedicated POI service when public Overpass is unavailable.
# When configured, Geoapify is preferred, and Overpass remains a fallback.
GEOAPIFY_API_KEY=

# Additional optional provider credentials: leave empty to keep capabilities explicitly unavailable.
TICKETMASTER_API_KEY=
BOOKING_API_TOKEN=
BOOKING_AFFILIATE_ID=
BOOKING_MODE=sandbox
# GTFS/rail, official visa rules and restaurant booking require partner-specific adapters.

# REST Countries v5 is optional and requires a key; without it Aligo uses limited World Bank country reference data.
RESTCOUNTRIES_API_KEY=

# Model-first multilingual travel planning. Keep the key server-side only.
ALIGO_AGENT_MODE=model-first
GROQ_API_KEY=
ALIGO_GROQ_MODEL=qwen/qwen3.8-27b

# Content quality checks are read-only and included in the API response.
# Optional: enable one bounded quality refinement if a new trip is weak.
# May increase latency by an additional local model generation.
ALIGO_CONTENT_REVIEW_MODE=adaptive

# Candidate and professional Skill budgets (bounded; defaults favor small local models).
ALIGO_MAX_DISCOVERY_CITIES=4
ALIGO_CITY_CANDIDATE_LIMIT=12
ALIGO_DAY_CANDIDATE_LIMIT=7
ALIGO_PROFESSIONAL_SKILL_BUDGET=5
ALIGO_PROFESSIONAL_RESULTS_PER_SKILL=4
# Cache only stable geocoding and mapped candidate lookups. No weather/booking caching.
ALIGO_GEOCODE_CACHE_TTL=900
ALIGO_PLACES_CACHE_TTL=300
# SSE keepalives and bounded pending messages.
ALIGO_SSE_HEARTBEAT_SECONDS=15
ALIGO_SSE_QUEUE_SIZE=64
# A bearer token alone does not establish a user identity or support multitenancy.
# For intentionally shared single-user remote access only, explicitly enable:
ALIGO_ALLOW_SHARED_REMOTE=false

# Diagnostic benchmark ablation: none, nine, eighteen (default).
ALIGO_ITINERARY_SKILL_MODE=eighteen
